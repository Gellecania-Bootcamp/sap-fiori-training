<mvc:View xmlns:mvc="sap.ui.core.mvc" 
          xmlns="sap.m" 
          xmlns:sap.ui.layout.form="sap.ui.layout.form" 
          xmlns:sap.ui.layout="sap.ui.layout" 
          xmlns:core="sap.ui.core"
          controllerName="com.acn.training.project1.controller.View1">

    <Page id="page" title="{i18n>title}">
    <content>
        <VBox width="100%" id="vbox0" direction="Column" alignItems="Center">
            <items>
                <sap.ui.layout.form:Form editable="true" id="form2">
                    <sap.ui.layout.form:formContainers>
                        <sap.ui.layout.form:FormContainer title="Exercise 1" id="container2">
                            <sap.ui.layout.form:formElements>

                                <!-- Name -->
                                <sap.ui.layout.form:FormElement label="Name" id="element3">
                                    <sap.ui.layout.form:fields>
                                        <Input width="100%" id="input4"/>   
                                    </sap.ui.layout.form:fields>
                                </sap.ui.layout.form:FormElement>

                                <!-- Street/No. -->
                                <sap.ui.layout.form:FormElement label="Street/No." id="element3_copy">
                                <sap.ui.layout.form:fields>
                                    <sap.ui.layout:FixFlex id="flex1">
                                        <sap.ui.layout:fixContent>
                                            <Input id="input7" width="70%"/>
                                            <Input id="input8" width="30%" type="Number"/>
                                        </sap.ui.layout:fixContent>
                                    </sap.ui.layout:FixFlex>
                                </sap.ui.layout.form:fields>
                                </sap.ui.layout.form:FormElement>

                                <!-- Zip Code/City-->
                                <sap.ui.layout.form:FormElement label="Zip Code/City" id="element3_copy2">
                                <sap.ui.layout.form:fields>
                                    <sap.ui.layout:FixFlex id="flex2">
                                        <sap.ui.layout:fixContent>
                                            <Input id="input10" width="30%" type="Number"/>
                                            <Input id="input11" width="70%"/>
                                        </sap.ui.layout:fixContent>
                                    </sap.ui.layout:FixFlex>
                                </sap.ui.layout.form:fields>
                                </sap.ui.layout.form:FormElement>

                                <!-- Country -->
                                <sap.ui.layout.form:FormElement label="Country" id="element3_copy3">
                                    <sap.ui.layout.form:fields>
                                        <Select id="select0">
                                            <items>
                                                <core:Item key="item-key-1" text="England" id="item0"/>
                                                <core:Item key="item-key-2" text="Germany" id="item1"/>
                                                <core:Item key="item-key-2" text="USA" id="item1_copy"/>
                                                <core:Item key="item-key-2" text="Philippines" id="item1_copy2"/>
                                                </items>
                                        </Select>
                                    </sap.ui.layout.form:fields>                                    
                                </sap.ui.layout.form:FormElement>

                                <!-- Toolbar buttons -->
                                <sap.ui.layout.form:FormElement id="element33">
                                <sap.ui.layout.form:fields>
                                    <Toolbar width="100%" id="toolbar6" style="Clear" design="Transparent" class="customToolbar">
                                        <content>
                                            <ToolbarSpacer id="spacer2"/>
                                            <Button text="Clear" id="button11" type="Reject" width="15%" press="onClearPress"/>
                                            <Button text="Save" id="button12" type="Accept" width="15%"/>
                                        </content>
                                    </Toolbar>
                                </sap.ui.layout.form:fields>
                                </sap.ui.layout.form:FormElement>
                                </sap.ui.layout.form:formElements>
                        </sap.ui.layout.form:FormContainer>
                    </sap.ui.layout.form:formContainers>

                    <sap.ui.layout.form:layout>
                        <sap.ui.layout.form:ResponsiveGridLayout id="layout3"/>
                    </sap.ui.layout.form:layout>
                </sap.ui.layout.form:Form>
            </items>
        </VBox>
    </content>
    </Page>
</mvc:View>